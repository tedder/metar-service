{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishAndTestTheFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:UpdateFunctionCode",
        "lambda:PublishVersion",
        "lambda:ListVersionsByFunction",
        "lambda:InvokeFunction"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:${AWS_ACCOUNT_ID}:function:metar-service",
        "arn:aws:lambda:us-east-1:${AWS_ACCOUNT_ID}:function:metar-service:*"
      ]
    },
    {
      "Sid": "LetCloudFrontReplicateAVersion",
      "Effect": "Allow",
      "Action": ["lambda:EnableReplication*", "lambda:DisableReplication*"],
      "Resource": "arn:aws:lambda:us-east-1:${AWS_ACCOUNT_ID}:function:metar-service:*"
    },
    {
      "Sid": "PointTheMetarBehaviorAtAVersion",
      "Effect": "Allow",
      "Action": ["cloudfront:GetDistribution", "cloudfront:GetDistributionConfig", "cloudfront:UpdateDistribution"],
      "Resource": "arn:aws:cloudfront::${AWS_ACCOUNT_ID}:distribution/${CF_DISTRIBUTION_ID}"
    }
  ]
}
